<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen (Android < 12): Astrea gradient with the white pedestrian. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF43A047"
                android:endColor="#FFFFA726" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_pedestrian" />
    </item>
</layer-list>
